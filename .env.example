# CI settings: https://github.com/shelajev/exa-sbx-kit/settings/secrets/actions
# Repository variable: Docker Hub username / target namespace.
DOCKERHUB_USERNAME=olegselajev241
# Repository secret: Docker Hub access token with write access to the kit repository.
# Create at https://app.docker.com/settings/personal-access-tokens
DOCKERHUB_TOKEN=your-dockerhub-write-token
# Runtime Exa key stays in the host secret store: sbx secret set -g exa.
# No real Exa key is needed in this checkout or CI.
